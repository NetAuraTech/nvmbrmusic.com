<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Theme bootstrap must run before first paint, but the production CSP
      (`script-src 'self'`) blocks inline scripts — hence a same-origin static
      file instead. See `public/scripts/theme-init.js`.
    -->
    <script src="/scripts/theme-init.js"></script>
    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>
  <body>
    @inertia()
  </body>
</html>
